# SSL Certificate Manager — Development Environment
# Copy to .env and fill in values for local development

# Required — 32-byte base64 key for encrypting stored private keys
# Generate with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CERT_MASTER_KEY=

# Required — API key for authenticating requests
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

# Application
BASE_URL=https://certs.cso.internal
DATA_DIR=/var/lib/certmanager
LOG_LEVEL=DEBUG
LOG_FILE=/var/log/certmanager/app.log

# Certificate constraints
MAX_CERT_DAYS=398

# Export
EXPORT_TTL_HOURS=24

# Backup
BACKUP_DIR=/var/lib/certmanager/backups
BACKUP_ENABLED=true
BACKUP_INTERVAL_HOURS=24
BACKUP_RETAIN_COUNT=5

# Database — if empty, uses SQLite at DATA_DIR/certmanager.db
# PostgreSQL: DATABASE_URL=postgresql+asyncpg://certmanager:secret@localhost:5432/certmanager
# MySQL:      DATABASE_URL=mysql+aiomysql://certmanager:secret@localhost:3306/certmanager
DATABASE_URL=
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# Bootstrap
BOOTSTRAP_IP=127.0.0.1
BOOTSTRAP_EXTRA_SANS=
BOOTSTRAP_CA_CN=Internal Root CA
BOOTSTRAP_CA_DAYS=3650
BOOTSTRAP_CERT_DAYS=398

# JDK (auto-detected if keytool is on PATH)
# JDK_HOME=/usr/lib/jvm/java-17-openjdk-amd64

# CFR decompiler jar, used by the JAR Analyser's on-demand decompile feature
# (auto-detected at /opt/certmanager/tools/cfr.jar if unset — that's where the
# Docker image bundles it)
# CFR_JAR_PATH=/opt/certmanager/tools/cfr.jar

# Vineflower — second decompiler engine, run alongside CFR on every decompile
# (auto-detected at /opt/certmanager/tools/vineflower.jar if unset)
# VINEFLOWER_JAR_PATH=/opt/certmanager/tools/vineflower.jar

# Monitoring
EXPIRY_SCAN_INTERVAL_HOURS=24
EXPIRY_WARN_DAYS=60,30,7

# Notifications (optional)
# NOTIFY_WEBHOOK_URL=https://hooks.example.com/certmanager
