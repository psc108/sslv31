PLATFORM INSTRUCTIONS
{{ '-' * 60 }}

1. LINUX (Debian / Ubuntu)
   sudo bash install-ca-debian.sh
   — OR manually:
   sudo cp root-ca.pem /usr/local/share/ca-certificates/{{ ca_cn_safe }}.crt
   sudo update-ca-certificates

2. LINUX (RHEL / Rocky / AlmaLinux)
   sudo bash install-ca-rhel.sh
   — OR manually:
   sudo cp root-ca.pem /etc/pki/ca-trust/source/anchors/{{ ca_cn_safe }}.pem
   sudo update-ca-trust extract

3. WINDOWS
   Run install-ca-windows.ps1 as Administrator
   — OR manually (cmd as Admin):
   certutil -addstore -f "Root" root-ca.cer

4. JAVA / SPRING BOOT
   Import root CA into JVM truststore:
   keytool -importcert -alias {{ ca_cn_safe }} \
     -file root-ca.pem \
     -keystore $JAVA_HOME/lib/security/cacerts \
     -storepass changeit -noprompt

   Application properties:
   -Djavax.net.ssl.trustStore=/path/to/truststore.jks
   -Djavax.net.ssl.trustStorePassword=<password>
   -Djavax.net.ssl.trustStoreType=JKS

5. BROWSER
   Chrome: Settings → Privacy → Security → Manage certificates → Authorities → Import → root-ca.pem
   Firefox: Settings → Privacy → View Certificates → Authorities → Import → root-ca.pem

VERIFICATION COMMANDS
{{ '-' * 60 }}

# Verify leaf certificate
openssl x509 -in {{ cn }}-cert.pem -text -noout

# Verify chain
openssl verify -CAfile root-ca.pem {{ cn }}-chain.pem

# Verify private key matches certificate
openssl x509 -in {{ cn }}-cert.pem -noout -modulus | md5sum
openssl rsa -in {{ cn }}-key.pem -noout -modulus | md5sum
# (Both MD5 sums should match)

# Windows — verify import
certutil -verify {{ cn }}-cert.der

# Java — list keystore contents
keytool -list -v -keystore keystore.jks -storepass <password>
