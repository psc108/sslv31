#!/bin/bash
# SSL Certificate Manager — CA Trust Installation (Arch Linux)
# Generated: {{ timestamp }}
# Root CA: {{ ca_cn }}

set -euo pipefail

CA_FILE="{{ ca_filename }}"
DEST="/etc/ca-certificates/trust-source/anchors/${CA_FILE}"

if [[ $EUID -ne 0 ]]; then
    echo "ERROR: This script must be run as root (use sudo)." >&2
    exit 1
fi

if [[ ! -f "./${CA_FILE}" ]]; then
    echo "ERROR: ${CA_FILE} not found in current directory." >&2
    exit 1
fi

echo "Installing ${CA_FILE} to ${DEST}..."
cp "./${CA_FILE}" "${DEST}"
chmod 644 "${DEST}"

echo "Updating trust store..."
trust extract-compat

echo "✓ Root CA installed successfully."
