#!/bin/bash
# SSL Certificate Manager — CA Trust Installation (Debian/Ubuntu)
# Generated: {{ timestamp }}
# Root CA: {{ ca_cn }}
#
# This script installs the internal root CA certificate into the
# system trust store on Debian-based Linux distributions.

set -euo pipefail

CA_FILE="{{ ca_filename }}"
DEST="/usr/local/share/ca-certificates/${CA_FILE}"

# Root check
if [[ $EUID -ne 0 ]]; then
    echo "ERROR: This script must be run as root (use sudo)." >&2
    exit 1
fi

# Check CA file exists
if [[ ! -f "./${CA_FILE}" ]]; then
    echo "ERROR: ${CA_FILE} not found in current directory." >&2
    exit 1
fi

# Backup existing if present
if [[ -f "${DEST}" ]]; then
    echo "Backing up existing ${DEST} to ${DEST}.bak"
    cp "${DEST}" "${DEST}.bak"
fi

# Install
echo "Installing ${CA_FILE} to ${DEST}..."
cp "./${CA_FILE}" "${DEST}"
chmod 644 "${DEST}"

# Update system trust store
echo "Updating system CA certificates..."
update-ca-certificates

echo ""
echo "✓ Root CA installed successfully."
echo "  Verify: openssl verify -CAfile /etc/ssl/certs/ca-certificates.crt ./${CA_FILE}"
