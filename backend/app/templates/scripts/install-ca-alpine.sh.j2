#!/bin/sh
# SSL Certificate Manager — CA Trust Installation (Alpine Linux)
# Generated: {{ timestamp }}
# Root CA: {{ ca_cn }}

set -eu

CA_FILE="{{ ca_filename }}"
DEST="/usr/local/share/ca-certificates/${CA_FILE}"

if [ "$(id -u)" -ne 0 ]; then
    echo "ERROR: This script must be run as root." >&2
    exit 1
fi

if [ ! -f "./${CA_FILE}" ]; then
    echo "ERROR: ${CA_FILE} not found in current directory." >&2
    exit 1
fi

echo "Installing ${CA_FILE} to ${DEST}..."
cp "./${CA_FILE}" "${DEST}"
chmod 644 "${DEST}"

echo "Updating CA certificates..."
update-ca-certificates

echo "✓ Root CA installed successfully."
