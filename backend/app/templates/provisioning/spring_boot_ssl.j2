# Spring Boot SSL/TLS Configuration
# Generated by SSL Certificate Manager for environment: {{ env_name }}
# Role: {{ role | capitalize }}
# Machine: {{ hosts[role].fqdn }} ({{ hosts[role].ip }})
# Deploy stores to: {{ base_path }}/{{ role }}/stores/

# ============================================================
# Server SSL (inbound HTTPS)
# ============================================================
server:
  port: 8443
  ssl:
    enabled: true
    key-store: file:{{ base_path }}/{{ role }}/stores/server-keystore.p12
    key-store-type: PKCS12
    key-store-password: {{ enc_ssl_passphrase }}
    key-alias: server
{% if role in ("backend", "frontend") %}
    # mTLS — require client certificates from connecting services
    client-auth: need
{% endif %}
    trust-store: file:{{ base_path }}/{{ role }}/stores/truststore.p12
    trust-store-type: PKCS12
    trust-store-password: {{ enc_ssl_passphrase }}
    protocol: TLS
    enabled-protocols: {{ cipher.protocols }}
    ciphers: {{ cipher.ciphers }}

# ============================================================
# Jasypt encryption configuration
# ============================================================
jasypt:
  encryptor:
    algorithm: PBEWITHSHA256AND256BITAES-CBC-BC
    provider-name: BC
    key-obtention-iterations: 1000
    # Master password provided via: -Djasypt.encryptor.password={{ encryption_key }}

{% if role in ("backend", "frontend") %}
# ============================================================
# Outbound mTLS client (Spring SSL Bundles — Spring Boot 3.1+)
# ============================================================
spring:
  ssl:
    bundle:
      jks:
        mtls-client:
          keystore:
            location: file:{{ base_path }}/{{ role }}/stores/client-keystore.p12
            type: PKCS12
            password: {{ enc_ssl_passphrase }}
          truststore:
            location: file:{{ base_path }}/{{ role }}/stores/truststore.p12
            type: PKCS12
            password: {{ enc_ssl_passphrase }}
{% endif %}

{% if role == "backend" %}
# ============================================================
# DataSource (MySQL with SSL + mTLS)
# ============================================================
spring:
  datasource:
    url: jdbc:mysql://{{ hosts.mysql.fqdn }}:3306/ssp_db?useSSL=true&requireSSL=true&verifyServerCertificate=true&trustCertificateKeyStoreUrl=file://{{ base_path }}/{{ role }}/stores/truststore.p12&trustCertificateKeyStoreType=PKCS12&trustCertificateKeyStorePassword={{ ssl_passphrase }}&clientCertificateKeyStoreUrl=file://{{ base_path }}/{{ role }}/stores/client-keystore.p12&clientCertificateKeyStoreType=PKCS12&clientCertificateKeyStorePassword={{ ssl_passphrase }}&serverTimezone=UTC
    # Or use ENC() values:
    # url: jdbc:mysql://{{ hosts.mysql.fqdn }}:3306/ssp_db?useSSL=true&requireSSL=true&verifyServerCertificate=true&trustCertificateKeyStoreUrl=file://{{ base_path }}/{{ role }}/stores/truststore.p12&trustCertificateKeyStoreType=PKCS12&trustCertificateKeyStorePassword={{ enc_ssl_passphrase }}&clientCertificateKeyStoreUrl=file://{{ base_path }}/{{ role }}/stores/client-keystore.p12&clientCertificateKeyStoreType=PKCS12&clientCertificateKeyStorePassword={{ enc_ssl_passphrase }}&serverTimezone=UTC

{% endif %}
# ============================================================
# RabbitMQ SSL connection
# ============================================================
spring:
  rabbitmq:
    host: {{ hosts.rabbitmq.fqdn }}
    port: 5671
    ssl:
      enabled: true
      key-store: file:{{ base_path }}/{{ role }}/stores/client-keystore.p12
      key-store-type: PKCS12
      key-store-password: {{ enc_ssl_passphrase }}
      trust-store: file:{{ base_path }}/{{ role }}/stores/truststore.p12
      trust-store-type: PKCS12
      trust-store-password: {{ enc_ssl_passphrase }}
      verify-hostname: true
      algorithm: TLSv1.2

{% if role == "backend" %}
# ============================================================
# Keystone (IDM) connection
# ============================================================
# idm:
#   url: https://{{ hosts.keystone.fqdn }}:5000/v3
#   ssl:
#     trust-store: file:{{ base_path }}/{{ role }}/stores/truststore.p12
#     trust-store-password: {{ enc_ssl_passphrase }}
{% endif %}

{% if role == "frontend" %}
# ============================================================
# Backend connection (from frontend)
# ============================================================
# backend:
#   url: https://{{ hosts.backend.fqdn }}:8443
#   ssl:
#     key-store: file:{{ base_path }}/{{ role }}/stores/client-keystore.p12
#     key-store-password: {{ enc_ssl_passphrase }}
#     trust-store: file:{{ base_path }}/{{ role }}/stores/truststore.p12
#     trust-store-password: {{ enc_ssl_passphrase }}
{% endif %}

# ============================================================
# JVM arguments (add to startup script or JAVA_OPTS)
# ============================================================
# -Djavax.net.ssl.trustStore={{ base_path }}/{{ role }}/stores/truststore.p12
# -Djavax.net.ssl.trustStorePassword={{ ssl_passphrase }}
# -Djavax.net.ssl.trustStoreType=PKCS12
# -Djavax.net.ssl.keyStore={{ base_path }}/{{ role }}/stores/server-keystore.p12
# -Djavax.net.ssl.keyStorePassword={{ ssl_passphrase }}
# -Djavax.net.ssl.keyStoreType=PKCS12
# -Djasypt.encryptor.password={{ encryption_key }}
# -Djavax.net.debug=ssl:handshake  (for debugging only)
