# Apache Keystone SSL VirtualHost Configuration
# Generated by SSL Certificate Manager for environment: {{ env_name }}
# Deploy to: {{ base_path }}/keystone/
# Machine: {{ hosts.keystone.fqdn }} ({{ hosts.keystone.ip }})

# ============================================================
# Public API (port 5000)
# ============================================================
<VirtualHost *:5000>
    ServerName {{ hosts.keystone.fqdn }}

    SSLEngine on
    SSLCertificateFile {{ base_path }}/keystone/certs/server-cert.pem
    SSLCertificateKeyFile {{ base_path }}/keystone/certs/server.key.nopass
    SSLCACertificateFile {{ base_path }}/keystone/certs/ca.pem

    # Protocol and cipher configuration
{% if cipher_profile == "modern" %}
    SSLProtocol all -SSLv3 -TLSv1 -TLSv1.1 -TLSv1.2
{% elif cipher_profile == "intermediate" %}
    SSLProtocol all -SSLv3 -TLSv1 -TLSv1.1
{% else %}
    SSLProtocol all -SSLv3 -TLSv1
{% endif %}
    SSLCipherSuite {{ cipher.openssl_ciphers }}
    SSLHonorCipherOrder on
    SSLCompression off
    SSLSessionTickets off

    # Security headers
    Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains"
    Header always set X-Content-Type-Options "nosniff"

    # Keystone WSGI
    WSGIDaemonProcess keystone-public processes=5 threads=1 user=keystone group=keystone display-name=%{GROUP}
    WSGIProcessGroup keystone-public
    WSGIScriptAlias / /usr/bin/keystone-wsgi-public
    WSGIApplicationGroup %{GLOBAL}
    WSGIPassAuthorization On

    <Directory /usr/bin>
        Require all granted
    </Directory>

    ErrorLog /var/log/apache2/keystone-ssl-error.log
    CustomLog /var/log/apache2/keystone-ssl-access.log combined
</VirtualHost>

# ============================================================
# HTTP → HTTPS redirect (optional)
# ============================================================
# <VirtualHost *:5000>
#     ServerName {{ hosts.keystone.fqdn }}
#     Redirect permanent / https://{{ hosts.keystone.fqdn }}:5000/
# </VirtualHost>

