#!/bin/bash
# Verify SSL certificate deployment on SSP machines
# Generated by SSL Certificate Manager for environment: {{ env_name }}
# Run from jumpserver after distribute-certs.sh

set -e

BASE_PATH="{{ base_path }}"
{% for role, host in hosts.items() %}
{{ role.upper() }}_HOST="{{ host.fqdn }}"
{% endfor %}

ERRORS=0

echo "=== Verifying SSL certificates for {{ env_name }} ==="
echo ""

{% for role, host in hosts.items() %}
echo "--- {{ role | capitalize }} (${{ role.upper() }}_HOST) ---"

# Check cert exists and is readable
ssh ${{ role.upper() }}_HOST "test -f $BASE_PATH/{{ role }}/certs/server-cert.pem" && echo "  [OK] server-cert.pem exists" || { echo "  [FAIL] server-cert.pem missing"; ERRORS=$((ERRORS+1)); }

# Check cert expiry
EXPIRY=$(ssh ${{ role.upper() }}_HOST "openssl x509 -enddate -noout -in $BASE_PATH/{{ role }}/certs/server-cert.pem 2>/dev/null | cut -d= -f2")
if [ -n "$EXPIRY" ]; then
    echo "  [OK] Expires: $EXPIRY"
else
    echo "  [FAIL] Cannot read certificate expiry"
    ERRORS=$((ERRORS+1))
fi

# Verify cert chains to CA
ssh ${{ role.upper() }}_HOST "openssl verify -CAfile $BASE_PATH/{{ role }}/certs/ca.pem $BASE_PATH/{{ role }}/certs/server-cert.pem 2>/dev/null | grep -q 'OK'" && echo "  [OK] Chain validates" || { echo "  [FAIL] Chain validation failed"; ERRORS=$((ERRORS+1)); }

# Check key matches cert
CERT_MOD=$(ssh ${{ role.upper() }}_HOST "openssl x509 -noout -modulus -in $BASE_PATH/{{ role }}/certs/server-cert.pem 2>/dev/null | md5sum")
KEY_MOD=$(ssh ${{ role.upper() }}_HOST "openssl rsa -noout -modulus -in $BASE_PATH/{{ role }}/certs/server.key.nopass 2>/dev/null | md5sum")
if [ "$CERT_MOD" = "$KEY_MOD" ]; then
    echo "  [OK] Key matches certificate"
else
    echo "  [FAIL] Key does NOT match certificate"
    ERRORS=$((ERRORS+1))
fi

# Check SAN contains expected hostname
SAN=$(ssh ${{ role.upper() }}_HOST "openssl x509 -noout -ext subjectAltName -in $BASE_PATH/{{ role }}/certs/server-cert.pem 2>/dev/null")
echo "$SAN" | grep -q "{{ host.fqdn }}" && echo "  [OK] SAN contains {{ host.fqdn }}" || { echo "  [FAIL] SAN missing {{ host.fqdn }}"; ERRORS=$((ERRORS+1)); }

{% if role in ("mysql", "backend", "frontend") %}
# Check keystore is readable
ssh ${{ role.upper() }}_HOST "openssl pkcs12 -info -in $BASE_PATH/{{ role }}/stores/server-keystore.p12 -passin pass:{{ ssl_passphrase }} -nokeys 2>/dev/null | grep -q 'subject'" && echo "  [OK] server-keystore.p12 readable" || { echo "  [FAIL] Cannot read server-keystore.p12"; ERRORS=$((ERRORS+1)); }
{% endif %}

echo ""
{% endfor %}

echo "=== Verification complete ==="
if [ $ERRORS -eq 0 ]; then
    echo "All checks passed."
    exit 0
else
    echo "ERRORS: $ERRORS check(s) failed."
    exit 1
fi
