# mqtt.ssl_options.cacertfile = {{ base_path }}/rabbitmq/certs/ca.pem
# mqtt.ssl_options.certfile = {{ base_path }}/rabbitmq/certs/server-cert.pem
# mqtt.ssl_options.keyfile = {{ base_path }}/rabbitmq/certs/server.key.nopass

