# RabbitMQ SSL/TLS Configuration
# Generated by SSL Certificate Manager for environment: {{ env_name }}
# Deploy to: {{ base_path }}/rabbitmq/
# Machine: {{ hosts.rabbitmq.fqdn }} ({{ hosts.rabbitmq.ip }})

# ============================================================
# Listeners — disable plain AMQP, enable AMQPS only
# ============================================================
listeners.tcp = none
listeners.ssl.default = 5671

# ============================================================
# Server certificate
# ============================================================
ssl_options.cacertfile = {{ base_path }}/rabbitmq/certs/ca.pem
ssl_options.certfile = {{ base_path }}/rabbitmq/certs/server-cert.pem
ssl_options.keyfile = {{ base_path }}/rabbitmq/certs/server.key.nopass

# ============================================================
# mTLS — require client certificates
# ============================================================
ssl_options.verify = verify_peer
ssl_options.fail_if_no_peer_cert = true
ssl_options.depth = 2

# ============================================================
# TLS versions
# ============================================================
{% if cipher_profile == "modern" %}
ssl_options.versions.1 = tlsv1.3
{% elif cipher_profile == "intermediate" %}
ssl_options.versions.1 = tlsv1.3
ssl_options.versions.2 = tlsv1.2
{% else %}
ssl_options.versions.1 = tlsv1.3
ssl_options.versions.2 = tlsv1.2
ssl_options.versions.3 = tlsv1.1
{% endif %}

# ============================================================
# Cipher suites
# ============================================================
{% set ciphers = cipher.ciphers.split(",") %}
{% for c in ciphers %}
ssl_options.ciphers.{{ loop.index }} = {{ c }}
{% endfor %}

# Cipher ordering
ssl_options.honor_cipher_order = true
ssl_options.honor_ecc_order = true

# ============================================================
# Management UI SSL (port 15671)
# ============================================================
management.ssl.port = 15671
management.ssl.cacertfile = {{ base_path }}/rabbitmq/certs/ca.pem
management.ssl.certfile = {{ base_path }}/rabbitmq/certs/server-cert.pem
management.ssl.keyfile = {{ base_path }}/rabbitmq/certs/server.key.nopass
management.ssl.honor_cipher_order = true
management.ssl.client_renegotiation = false
management.ssl.secure_renegotiate = true

# ============================================================
# Inter-node communication (clustering)
# Uncomment if running a RabbitMQ cluster:
# ============================================================
# cluster_formation.peer_discovery_backend = rabbit_peer_discovery_classic_config
# distribution.listener.ssl = true
# distribution.listener.ssl_options.cacertfile = {{ base_path }}/rabbitmq/certs/ca.pem
# distribution.listener.ssl_options.certfile = {{ base_path }}/rabbitmq/certs/server-cert.pem
# distribution.listener.ssl_options.keyfile = {{ base_path }}/rabbitmq/certs/server.key.nopass

