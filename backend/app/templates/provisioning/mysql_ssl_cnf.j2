# MySQL SSL Configuration
# Generated by SSL Certificate Manager for environment: {{ env_name }}
# Deploy to: {{ base_path }}/mysql/
# Machine: {{ hosts.mysql.fqdn }} ({{ hosts.mysql.ip }})

[mysqld]
# Server SSL certificates
ssl-ca={{ base_path }}/mysql/certs/ca.pem
ssl-cert={{ base_path }}/mysql/certs/server-cert.pem
ssl-key={{ base_path }}/mysql/certs/server.key.nopass
require_secure_transport=ON
tls_version={{ cipher.protocols }}
{% if cipher_profile != "modern" %}
ssl-cipher={{ cipher.openssl_ciphers }}
{% endif %}

# mTLS — require client certificates from backend
# Uncomment to enforce (recommended for production):
# ssl-mode=VERIFY_IDENTITY

[client]
# Client connection with SSL verification
ssl-ca={{ base_path }}/mysql/certs/ca.pem
ssl-mode=VERIFY_IDENTITY

# For mTLS connections from backend:
# ssl-cert={{ base_path }}/backend/certs/client-cert.pem
# ssl-key={{ base_path }}/backend/certs/client.key.nopass

# ============================================================
# SQL: Create user requiring SSL/mTLS
# ============================================================
# CREATE USER 'ssp_app'@'{{ hosts.backend.ip }}' IDENTIFIED BY '<password>' REQUIRE X509;
# GRANT ALL ON ssp_db.* TO 'ssp_app'@'{{ hosts.backend.ip }}';
# FLUSH PRIVILEGES;

# ============================================================
# JDBC URL (for backend application.properties)
# ============================================================
# jdbc:mysql://{{ hosts.mysql.fqdn }}:3306/ssp_db?useSSL=true&requireSSL=true&verifyServerCertificate=true&trustCertificateKeyStoreUrl=file://{{ base_path }}/backend/stores/truststore.p12&trustCertificateKeyStoreType=PKCS12&trustCertificateKeyStorePassword={{ ssl_passphrase }}&clientCertificateKeyStoreUrl=file://{{ base_path }}/backend/stores/client-keystore.p12&clientCertificateKeyStoreType=PKCS12&clientCertificateKeyStorePassword={{ ssl_passphrase }}&serverTimezone=UTC

# ============================================================
# Verification commands (run after deployment)
# ============================================================
# mysql -e "SHOW VARIABLES LIKE '%ssl%';"
# mysql -e "SHOW STATUS LIKE 'Ssl_cipher';"
# openssl s_client -connect {{ hosts.mysql.fqdn }}:3306 -starttls mysql -CAfile {{ base_path }}/mysql/certs/ca.pem
