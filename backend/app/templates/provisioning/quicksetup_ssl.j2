# SSL Configuration for quicksetup.properties
# Generated by SSL Certificate Manager for environment: {{ env_name }}
# Paste these values into your quicksetup.properties file.
# Date: Generated by SSL Certificate Manager

# ============================================================
# SSL Settings
# ============================================================
sslEnabled=true
sslPassphrase={{ ssl_passphrase }}
sslPassphraseEncoded={{ enc_ssl_passphrase }}
sslCiphers={{ cipher.ciphers }}
sslUICiphers={{ cipher.ciphers }}
ecdhCurve=prime256v1
sslProtocols={{ cipher.protocols }}
rabbitmqSSLEnabled=true
securityTrustAllCerts=false

# ============================================================
# Encryption (Jasypt)
# ============================================================
propertiesEncryptionAlgorithm=PBEWITHSHA256AND256BITAES-CBC-BC
propertiesEncryptionKey={{ encryption_key }}

# ============================================================
# Java Security (keystores/truststores)
# ============================================================
javaSecurityPassword={{ ssl_passphrase }}
javaSecurityPasswordEncoded={{ enc_ssl_passphrase }}
javaSecurityTrustStoreType=PKCS12
javaSecurityKeyStoreType=PKCS12

# ============================================================
# Hostnames
# ============================================================
frontendHostname={{ hosts.frontend.fqdn }}
frontendIP={{ hosts.frontend.ip }}
backendHostname={{ hosts.backend.fqdn }}
backendIP={{ hosts.backend.ip }}
mysqlHostname={{ hosts.mysql.fqdn }}
mysqlIP={{ hosts.mysql.ip }}
rabbitmqHostname={{ hosts.rabbitmq.fqdn }}
rabbitmqIP={{ hosts.rabbitmq.ip }}
keystoneHostname={{ hosts.keystone.fqdn }}
keystoneIP={{ hosts.keystone.ip }}

# ============================================================
# Database (MySQL with SSL + mTLS)
# ============================================================
dbHost={{ hosts.mysql.fqdn }}
dbPort=3306
dbSSLEnabled=true
dbUrl=jdbc:mysql://{{ hosts.mysql.fqdn }}:3306/${dbName}?autoReconnect=true&useSSL=true&requireSSL=true&verifyServerCertificate=true&trustCertificateKeyStoreUrl=file://{{ base_path }}/backend/stores/truststore.p12&trustCertificateKeyStoreType=PKCS12&trustCertificateKeyStorePassword={{ ssl_passphrase }}&clientCertificateKeyStoreUrl=file://{{ base_path }}/backend/stores/client-keystore.p12&clientCertificateKeyStoreType=PKCS12&clientCertificateKeyStorePassword={{ ssl_passphrase }}&serverTimezone=UTC

# ============================================================
# RabbitMQ
# ============================================================
rabbitmqHosts={{ hosts.rabbitmq.fqdn }}
rabbitmqPort=5671
rabbitmqSSLKeyStore={{ base_path }}/backend/stores/client-keystore.p12
rabbitmqSSLTrustStore={{ base_path }}/backend/stores/truststore.p12
rabbitmqSSLKeyStorePassword={{ enc_ssl_passphrase }}
rabbitmqSSLTrustStorePassword={{ enc_ssl_passphrase }}

# ============================================================
# Keystone (IDM)
# ============================================================
idmHosts={{ hosts.keystone.fqdn }}
idmPort=5000
idmProtocol=https
idmSSLEnabled=true

# ============================================================
# Certificate Paths
# ============================================================
sslBasePath={{ base_path }}
sslCAFile={{ base_path }}/ca/ca.pem
backendServerKeystore={{ base_path }}/backend/stores/server-keystore.p12
backendClientKeystore={{ base_path }}/backend/stores/client-keystore.p12
backendTruststore={{ base_path }}/backend/stores/truststore.p12
frontendServerKeystore={{ base_path }}/frontend/stores/server-keystore.p12
frontendClientKeystore={{ base_path }}/frontend/stores/client-keystore.p12
frontendTruststore={{ base_path }}/frontend/stores/truststore.p12
