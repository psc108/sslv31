#!/bin/bash
# Distribute SSL certificates to SSP machines
# Generated by SSL Certificate Manager for environment: {{ env_name }}
# Run from jumpserver where the ZIP was extracted.
# Requires passwordless SSH to all target machines.

set -e

BASE_PATH="{{ base_path }}"
{% for role, host in hosts.items() %}
{{ role.upper() }}_HOST="{{ host.fqdn }}"
{% endfor %}

echo "=== Distributing SSL certificates for {{ env_name }} ==="
echo "Base path: $BASE_PATH"
echo ""

{% set counter = {"n": 1} %}
{% for role, host in hosts.items() %}
# {{ counter.n }}/{{ hosts|length }}: {{ role | capitalize }} ({{ host.fqdn }})
echo "[{{ counter.n }}/{{ hosts|length }}] {{ role | capitalize }} (${{ role.upper() }}_HOST)..."
ssh ${{ role.upper() }}_HOST "mkdir -p $BASE_PATH/{{ role }}/certs $BASE_PATH/{{ role }}/stores $BASE_PATH/{{ role }}/config"
scp {{ role }}/certs/* ${{ role.upper() }}_HOST:$BASE_PATH/{{ role }}/certs/
{% if role in ("mysql", "backend", "frontend") %}
scp {{ role }}/stores/* ${{ role.upper() }}_HOST:$BASE_PATH/{{ role }}/stores/
{% endif %}
scp {{ role }}/config/* ${{ role.upper() }}_HOST:$BASE_PATH/{{ role }}/config/
ssh ${{ role.upper() }}_HOST "chmod 600 $BASE_PATH/{{ role }}/certs/*.key* $BASE_PATH/{{ role }}/stores/*.p12 2>/dev/null; chmod 644 $BASE_PATH/{{ role }}/certs/*.pem"
echo "  Done."
{% set _ = counter.update({"n": counter.n + 1}) %}

{% endfor %}
# CA cert to all machines
echo "[+] Distributing CA cert to all machines..."
{% for role, host in hosts.items() %}
ssh ${{ role.upper() }}_HOST "mkdir -p $BASE_PATH/ca"
scp ca/ca.pem ${{ role.upper() }}_HOST:$BASE_PATH/ca/
{% endfor %}

echo ""
echo "=== Distribution complete ==="
echo "Run ./scripts/verify-certs.sh to validate installation."
