{
  "logs": {
    "logs_collected": {
      "files": {
        "collect_list": [
          {
            "file_path": "/var/log/syslog",
            "log_group_name": "/aws/ec2/{{ environment_name }}/app",
            "log_stream_name": "{{ ec2_instance_id }}/syslog",
            "timezone": "UTC"
          }{% if service_role == 'frontend' or service_role == 'backend' %},
          {
            "file_path": "/var/log/nginx/access.log",
            "log_group_name": "/aws/ec2/{{ environment_name }}/nginx",
            "log_stream_name": "{{ ec2_instance_id }}/access",
            "timezone": "UTC"
          },
          {
            "file_path": "/var/log/nginx/error.log",
            "log_group_name": "/aws/ec2/{{ environment_name }}/nginx",
            "log_stream_name": "{{ ec2_instance_id }}/error",
            "timezone": "UTC"
          }{% endif %}{% if service_role == 'mysql' %},
          {
            "file_path": "/var/log/mysql/error.log",
            "log_group_name": "/aws/ec2/{{ environment_name }}/mysql",
            "log_stream_name": "{{ ec2_instance_id }}/error",
            "timezone": "UTC"
          }{% endif %}{% if service_role == 'rabbitmq' %},
          {
            "file_path": "/var/log/rabbitmq/rabbit@*.log",
            "log_group_name": "/aws/ec2/{{ environment_name }}/rabbitmq",
            "log_stream_name": "{{ ec2_instance_id }}/rabbit",
            "timezone": "UTC"
          }{% endif %}{% if service_role == 'keystone' %},
          {
            "file_path": "/var/log/keystone/keystone.log",
            "log_group_name": "/aws/ec2/{{ environment_name }}/keystone",
            "log_stream_name": "{{ ec2_instance_id }}/keystone",
            "timezone": "UTC"
          }{% endif %}
        ]
      }
    }
  },
  "metrics": {
    "namespace": "CertManager/EC2",
    "metrics_collected": {
      "mem": {
        "measurement": ["mem_used_percent"],
        "metrics_collection_interval": 60
      },
      "disk": {
        "measurement": ["disk_used_percent"],
        "resources": ["/"],
        "metrics_collection_interval": 60
      }
    },
    "append_dimensions": {
      "Environment": "{{ environment_name }}",
      "InstanceId": "${aws:InstanceId}"
    }
  }
}
