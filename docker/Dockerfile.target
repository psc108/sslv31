FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive
ENV container=docker

# Install systemd and SSH
RUN apt-get update && apt-get install -y --no-install-recommends \
    systemd \
    systemd-sysv \
    openssh-server \
    python3 \
    python3-apt \
    sudo \
    curl \
    ca-certificates \
    dbus \
    && rm -rf /var/lib/apt/lists/*

# Upgrade the base image and pre-install dpkg-dev at build time, not at
# container runtime. Root cause (see Documentation/build_manager_operations_guide.md,
# "Golden-path template pitfalls" — the pkg_cache_seed live-libc6-upgrade
# incident): installing dpkg-dev live, over SSH, against a running container
# pulls in a libc6 (glibc) upgrade from noble-updates on this base image.
# Upgrading glibc while systemd/sshd are actively running against the old
# library, inside a privileged, nested-systemd container, crashes the
# container's process tree the moment anything forks mid-unpack — confirmed
# by reproducing it directly (SSH session dropped exactly at "Setting up
# libc6:amd64", RestartCount incremented immediately after). Baking the
# upgrade and dpkg-dev into the image build means it's already current
# before the container ever boots, so no Ansible role can trigger this
# live-upgrade window again.
RUN apt-get update && apt-get upgrade -y && apt-get install -y --no-install-recommends \
    dpkg-dev \
    && rm -rf /var/lib/apt/lists/*

# Remove unnecessary systemd units that cause issues in containers
RUN rm -f /lib/systemd/system/multi-user.target.wants/* \
    /etc/systemd/system/*.wants/* \
    /lib/systemd/system/local-fs.target.wants/* \
    /lib/systemd/system/sockets.target.wants/*udev* \
    /lib/systemd/system/sockets.target.wants/*initctl* \
    /lib/systemd/system/sysinit.target.wants/systemd-tmpfiles-setup* \
    /lib/systemd/system/systemd-update-utmp*

# Configure SSH
RUN mkdir -p /run/sshd /root/.ssh && \
    chmod 700 /root/.ssh && \
    sed -i 's/#PermitRootLogin.*/PermitRootLogin yes/' /etc/ssh/sshd_config && \
    sed -i 's/#PubkeyAuthentication.*/PubkeyAuthentication yes/' /etc/ssh/sshd_config && \
    echo "PasswordAuthentication no" >> /etc/ssh/sshd_config

# Enable SSH service to start on boot
RUN systemctl enable ssh

# Copy entrypoint that injects SSH keys then execs systemd
COPY docker/target-entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

EXPOSE 22

STOPSIGNAL SIGRTMIN+3
ENTRYPOINT ["/entrypoint.sh"]
